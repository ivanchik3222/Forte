# Flask
FLASK_ENV=development
SECRET_KEY=your-secret-key-here
JWT_SECRET_KEY=your-jwt-secret-here

# Порт для локального запуска (python app.py)
PORT=6767

# База данных (без этой переменной создаётся локальный SQLite в database/)
# DATABASE_URL=sqlite:///database/database.db
# DATABASE_URL=postgresql://user:password@localhost:5432/dbname

# CORS origins через запятую (без переменной — localhost:3000/5173)
CORS_ORIGINS=http://localhost:3000
COOKIE_SECURE=false
COOKIE_SAMESITE=Lax
AUTH_COOKIE_PATH=/api/auth
# FFPROBE_PATH=C:/tools/ffmpeg/bin/ffprobe.exe
# MEDIA_ROOT=C:/data/forte/media

# Local Mac pipeline: frozen bank event model followed by offline Qwen captions.
ML_ENGINE=reviewed_pipeline
ML_AUTO_ANALYZE=true
ML_VLM_MODEL_SIZE=4b
ML_VLM_INPUT_MODE=images
# The API and analysis-worker must use the same engine and database.
# ML_REVIEWED_PYTHON=/absolute/path/to/ML/.venv/bin/python
# ML_VLM_PYTHON=/absolute/path/to/ML/.venv-review/bin/python

# Jury endpoint: keep the key server-side. Mac launcher creates an ignored key file.
# JURY_API_KEY=<random-secret>
# JURY_API_KEY_FILE=/absolute/path/to/jury-api-key.txt

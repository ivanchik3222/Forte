# Flask
FLASK_ENV=development
SECRET_KEY=your-secret-key-here
JWT_SECRET_KEY=your-jwt-secret-here

# Порт для локального запуска (python app.py)
PORT=6767

# База данных (без этой переменной создаётся локальный SQLite в database/)
# DATABASE_URL=sqlite:///database/database.db
# DATABASE_URL=postgresql://user:password@localhost:5432/dbname

# CORS origins через запятую (без переменной — localhost:3000/5173)
CORS_ORIGINS=http://localhost:3000
COOKIE_SECURE=false
COOKIE_SAMESITE=Lax
AUTH_COOKIE_PATH=/api/auth
# FFPROBE_PATH=C:/tools/ffmpeg/bin/ffprobe.exe
# MEDIA_ROOT=C:/data/forte/media

# API жюри: отдельный случайный ключ и ID отдельного активного пользователя (user).
# JURY_API_KEY=generate-a-private-random-key
# JURY_OWNER_ID=123

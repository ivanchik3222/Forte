SECRET_KEY=replace-with-a-long-random-secret
JWT_SECRET_KEY=replace-with-another-long-random-secret
BACKEND_PORT=6767
FRONTEND_PORT=3000
REACT_APP_API_URL=http://localhost:6767
DEMO_MODE=true
CORS_ORIGINS=http://localhost:3000
COOKIE_SECURE=false
COOKIE_SAMESITE=Lax
# If the public API is mounted at /forte, set /forte/api/auth.
AUTH_COOKIE_PATH=/api/auth

# Linux: R3D + bank head; Qwen will run on a separate server.
ML_ENGINE=reviewed_pipeline
ML_VLM_BACKEND=disabled

# Только для compose.production.yaml на VPS: задайте случайный пароль.
# POSTGRES_PASSWORD=replace-with-a-long-random-password

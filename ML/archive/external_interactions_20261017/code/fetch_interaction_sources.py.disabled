"""Download bounded, reproducible research subsets from official public archives."""
import argparse
import csv
import hashlib
import io
import json
import struct
import time
import urllib.request
import zipfile
import zlib
from collections import defaultdict
from concurrent.futures import ThreadPoolExecutor
from pathlib import Path

import numpy as np
from PIL import Image

ROOT = Path(__file__).resolve().parent
OUT = ROOT / 'external/interaction_sources'
MERL = 'https://www.merl.com/pub/tmarks/MERL_Shopping_Dataset/'
MECCANO = 'https://iplab.dmi.unict.it/sharing/MECCANO/'
EPIC = 'https://raw.githubusercontent.com/epic-kitchens/epic-kitchens-100-annotations/master/'


def get(url, start=None, size=None):
    headers = {'User-Agent': 'Forte-local-research/1.0'}
    if start is not None:
        headers['Range'] = f'bytes={start}-{start + size - 1}'
    for attempt in range(3):
        try:
            with urllib.request.urlopen(urllib.request.Request(url, headers=headers), timeout=45) as response:
                if start is not None:
                    expected = f'bytes {start}-{start + size - 1}/'
                    if response.status != 206 or not response.headers.get('Content-Range', '').startswith(expected):
                        raise ValueError('Server did not honor the requested byte range')
                data = response.read((size if size is not None else 25 * 1024**2) + 1)
                if size is not None and len(data) != size:
                    raise ValueError('Incomplete byte range')
                if size is None and len(data) > 25 * 1024**2:
                    raise ValueError('Metadata exceeded download budget')
                return data
        except (OSError, ValueError):
            if attempt == 2:
                raise
            time.sleep(attempt + 1)


class RangeReader(io.RawIOBase):
    """Seekable HTTP reader used only to obtain the ZIP central directory."""
    def __init__(self, url):
        self.url, self.pos = url, 0
        with urllib.request.urlopen(urllib.request.Request(url, method='HEAD'), timeout=30) as response:
            self.length = int(response.headers['Content-Length'])

    def seekable(self):
        return True

    def tell(self):
        return self.pos

    def seek(self, offset, whence=0):
        target = offset if whence == 0 else self.pos + offset if whence == 1 else self.length + offset
        if target < 0:
            raise ValueError('Negative offset')
        self.pos = target
        return target

    def read(self, size=-1):
        size = min(self.length - self.pos, size if size >= 0 else self.length - self.pos)
        if size <= 0:
            return b''
        if size > 128 * 1024**2:
            raise ValueError('Archive index exceeded memory/download budget')
        data = get(self.url, self.pos, size)
        self.pos += len(data)
        return data


def index(url, path):
    if path.exists():
        return json.loads(path.read_text(encoding='utf-8'))
    with zipfile.ZipFile(RangeReader(url)) as archive:
        rows = [{k: getattr(info, k) for k in ('filename', 'file_size', 'compress_size',
                 'header_offset', 'CRC', 'compress_type', 'flag_bits')}
                for info in archive.infolist() if not info.is_dir()]
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(json.dumps(rows), encoding='utf-8')
    return rows


def member_bytes(url, info):
    if info['flag_bits'] & 1:
        raise ValueError('Encrypted archive member')
    header = get(url, info['header_offset'], 30)
    if header[:4] != b'PK\x03\x04':
        raise ValueError('Bad ZIP local header')
    name_len, extra_len = struct.unpack_from('<HH', header, 26)
    start = info['header_offset'] + 30 + name_len + extra_len
    packed = get(url, start, info['compress_size'])
    if info['compress_type'] == zipfile.ZIP_DEFLATED:
        data = zlib.decompress(packed, -15)
    elif info['compress_type'] == zipfile.ZIP_STORED:
        data = packed
    else:
        raise ValueError(f'Unsupported compression {info["compress_type"]}')
    if len(data) != info['file_size'] or zlib.crc32(data) & 0xffffffff != info['CRC']:
        raise ValueError('Archive member size/CRC mismatch')
    return data


def metadata():
    files = {
        'merl/ReadMe.md': MERL + 'ReadMe.md', 'merl/labels.zip': MERL + 'Labels_MERL_Shopping_Dataset.zip',
        'meccano/hands.zip': MECCANO + 'MECCANO_hands_bounding_box_annotations.zip',
        'meccano/actions.zip': MECCANO + 'MECCANO_action_annotations.zip',
        'meccano/README.md': 'https://raw.githubusercontent.com/fpv-iplab/MECCANO/master/README.md',
        'epic/README.md': EPIC + 'README.md', 'epic/verbs.csv': EPIC + 'EPIC_100_verb_classes.csv',
        'epic_train.txt': EPIC + 'EPIC_100_train.csv', 'epic_val.txt': EPIC + 'EPIC_100_validation.csv',
        'epic/visor_README.md': 'https://raw.githubusercontent.com/epic-kitchens/VISOR-VIS/main/README.md'}
    sources = []
    for name, url in files.items():
        path = OUT / name
        path.parent.mkdir(parents=True, exist_ok=True)
        if not path.exists():
            path.write_bytes(get(url))
        sources.append(dict(path=name, url=url, bytes=path.stat().st_size,
                            sha256=hashlib.sha256(path.read_bytes()).hexdigest()))
    (OUT / 'metadata_sources.json').write_text(json.dumps(sources, indent=2), encoding='utf-8')


def merl_subset():
    url = MERL + 'Videos_MERL_Shopping_Dataset.zip'
    rows = index(url, OUT / 'merl/archive_index.json')
    # Bounded pilot selected before training; preserve the original subject split.
    # Four train subjects and two val subjects, keeping already fetched sessions.
    pilot = {'1_1','1_2','1_3','2_1','3_1','4_1','21_1','21_2','21_3','22_2'}
    wanted = [r for r in rows if Path(r['filename']).suffix == '.mp4'
              and Path(r['filename']).stem.replace('_crop','') in pilot]
    wanted.sort(key=lambda r:int(Path(r['filename']).name.split('_')[0]))
    def fetch(info):
        path = OUT / 'merl/videos' / Path(info['filename']).name
        path.parent.mkdir(parents=True, exist_ok=True)
        if not path.exists():
            data = member_bytes(url, info)
            partial = path.with_suffix('.part')
            partial.write_bytes(data)
            partial.replace(path)
        else:
            data = path.read_bytes()
        if len(data) != info['file_size'] or zlib.crc32(data) & 0xffffffff != info['CRC']:
            raise ValueError('Cached video CRC mismatch')
        print('MERL', path.name, len(data), flush=True)
        subject = int(path.name.split('_')[0])
        return dict(path=str(path.relative_to(ROOT)), subject=subject,
                    split='train' if subject <= 20 else 'val', url=url, member=info['filename'],
                    sha256=hashlib.sha256(data).hexdigest(), bytes=len(data))
    with ThreadPoolExecutor(max_workers=4) as pool:
        downloaded = list(pool.map(fetch, wanted))
    (OUT / 'merl/subset.json').write_text(json.dumps(downloaded, indent=2), encoding='utf-8')


def meccano_subset():
    url = MECCANO + 'MECCANO_RGB_frames.zip'
    rows = index(url, OUT / 'meccano/archive_index.json')
    by_frame = {}
    for info in rows:
        parts = Path(info['filename']).parts
        if len(parts) >= 2 and parts[-1].endswith('.jpg'):
            by_frame[(parts[-2], parts[-1])] = info
    print('MECCANO indexed frames', len(by_frame), 'first', next(iter(by_frame)), flush=True)
    selected = []
    with zipfile.ZipFile(OUT / 'meccano/hands.zip') as annotations:
        for name in sorted(annotations.namelist()):
            if not name.endswith('.csv') or '/Test/' in name:
                continue
            split = 'train' if '/Train/' in name else 'val'
            video = Path(name).stem
            grouped = defaultdict(list)
            for row in csv.DictReader(io.StringIO(annotations.read(name).decode('utf-8-sig'))):
                shape = json.loads(row['region_shape_attributes'])
                if shape.get('name') == 'rect':
                    grouped[row['filename']].append([shape['x'], shape['y'],
                        shape['x'] + shape['width'], shape['y'] + shape['height']])
            candidates = sorted(f for f in grouped if (video, f) in by_frame)
            for i in np.unique(np.linspace(0, len(candidates) - 1, min(8, len(candidates)), dtype=int)):
                filename = candidates[i]
                selected.append(dict(video=video, filename=filename, split=split,
                                     source_xyxy=grouped[filename], info=by_frame[(video, filename)]))
    def fetch(row):
        path = OUT / 'meccano/images' / f'{row["video"]}_{row["filename"]}'
        path.parent.mkdir(parents=True, exist_ok=True)
        if not path.exists():
            path.write_bytes(member_bytes(url, row['info']))
        data = path.read_bytes()
        if zlib.crc32(data) & 0xffffffff != row['info']['CRC']:
            raise ValueError('Cached frame CRC mismatch')
        with Image.open(path) as image:
            width, height = image.size
        # Publisher RGB acquisition/annotation coordinate system: 1920x1080.
        # Two sampled source labels exceed the bottom image edge by one pixel.
        boxes = [[max(0,x1) * width / 1920, max(0,y1) * height / 1080,
                  min(1920,x2) * width / 1920, min(1080,y2) * height / 1080]
                 for x1, y1, x2, y2 in row['source_xyxy']]
        if any(not (0 <= b[0] < b[2] <= width and 0 <= b[1] < b[3] <= height) for b in boxes):
            raise ValueError('Box outside image; check annotation coordinate system')
        return dict(name=path.stem, path=str(path.relative_to(ROOT)), video=row['video'],
                    split=row['split'], width=width, height=height, boxes_xyxy=boxes,
                    source_xyxy=row['source_xyxy'], modification='Clip source boxes to image boundary',
                    annotation_coordinate_system=[1920, 1080], url=url, member=row['info']['filename'],
                    sha256=hashlib.sha256(data).hexdigest())
    with ThreadPoolExecutor(max_workers=8) as pool:
        downloaded = list(pool.map(fetch, selected))
    (OUT / 'meccano/subset.json').write_text(json.dumps(downloaded, indent=2), encoding='utf-8')
    print('MECCANO subset', len(downloaded), 'images', sum(len(r['boxes_xyxy']) for r in downloaded), 'hands', flush=True)


if __name__ == '__main__':
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--source', choices=['metadata', 'merl', 'meccano', 'all'], default='metadata')
    args = parser.parse_args()
    metadata()
    if args.source in ('merl', 'all'):
        merl_subset()
    if args.source in ('meccano', 'all'):
        meccano_subset()

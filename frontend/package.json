{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^13.5.0",
    "@types/jest": "^27.5.2",
    "@types/node": "^16.18.126",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router-dom": "^6.30.6",
    "react-scripts": "5.0.1",
    "typescript": "^4.9.5",
    "web-vitals": "^2.1.4",
    "zustand": "^5.0.15"
  },
  "scripts": {
    "prestart": "npm run css:build",
    "start": "npm-run-all -p css:watch react:start",
    "react:start": "react-scripts start",
    "css:build": "tailwindcss -i ./src/styles/input.css -o ./src/styles/generated.css --minify",
    "css:watch": "tailwindcss -i ./src/styles/input.css -o ./src/styles/generated.css --watch=always",
    "build": "npm run css:build && react-scripts build",
    "pretest": "npm run css:build",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "regulations:sync": "node scripts/sync-regulations.cjs"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "npm-run-all": "^4.1.5",
    "tailwindcss": "^4.3.3"
  }
}
